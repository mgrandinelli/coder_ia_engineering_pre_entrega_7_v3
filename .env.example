# Plantilla de variables de entorno: copiar como .env y completar la clave. El .env no se sube al repo.

# Redis Stack (docker compose lo expone en el puerto 6380)
REDIS_URL=redis://localhost:6380

# Proveedor del modelo de lenguaje: openai o anthropic. Sin clave, la API corre en modo demostración.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# Observabilidad con Arize Phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=atlas-orquestador
PHOENIX_ENABLED=true

# Cantidad de trabajos que se ejecutan a la vez
WORKER_CONCURRENCY=5
